{
  "name": "pyquest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:check": "node --no-warnings --experimental-strip-types scripts/validate-content.ts",
    "verify:solutions": "node --no-warnings --experimental-strip-types scripts/verify-reference-solutions.ts",
    "test": "node --no-warnings --test --experimental-strip-types tests/content-validation.test.ts tests/execution-runner.test.ts tests/challenge-evaluator.test.ts tests/env-validation.test.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
